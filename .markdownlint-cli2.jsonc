{
  // Layout checking for the ai-portal repository. Wording is a review concern.
  //
  // This is a baseline, not a cleanup. The one rule disabled below fires on
  // content that already exists; every other rule gates new work from today.
  "config": {
    "default": true,

    // 5 pre-existing findings, all in the generated AGENTS.md managed section,
    // whose table rows and pinned SHAs cannot wrap at 80 columns. AGENTS.md is
    // generated, so its findings are not this repository's to fix at all.
    "MD013": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
